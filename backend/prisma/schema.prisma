generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model PatchVersion {
  id            String   @id @default(cuid())
  version       String
  date          String
  size          String
  supernovaLink String?
  bigbangLink   String?
  changelog     String[]
  isLatest      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TeamMember {
  id        String @id @default(cuid())
  name      String
  role      String
  category  String
  discordId String?
  avatarUrl String?
  sortOrder Int    @default(0)
}

model TimelineEvent {
  id          String @id @default(cuid())
  date        String
  title       String
  description String
  sortOrder   Int    @default(0)
}

model Credit {
  id         String  @id @default(cuid())
  category   String
  personName String
  task       String?
  socialLink String?
  sortOrder  Int     @default(0)
}

model Screenshot {
  id        String @id @default(cuid())
  imageUrl  String
  sortOrder Int    @default(0)
}

model HeroBackground {
  id        String @id @default(cuid())
  imageUrl  String
  sortOrder Int    @default(0)
}

model WikiTool {
  id          String     @id @default(cuid())
  name        String
  description String
  imagePath   String?
  link        String?
  tags        String[]
  sortOrder   Int        @default(0)
  pages       WikiPage[]
}

model WikiPage {
  id        String   @id @default(cuid())
  slug      String
  title     String
  content   String
  toolId    String?
  tool      WikiTool? @relation(fields: [toolId], references: [id], onDelete: Cascade)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id              String   @id @default("default")
  patchVersion    String
  patchDate       String
  patchSize       String
  supernovaLink   String?
  bigbangLink     String?
  supernovaRomLink String?
  bigbangRomLink   String?
  supernovaRomSize String?
  bigbangRomSize   String?
  showPatch       Boolean  @default(true)
  showRom         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  date      DateTime @default(now())
  userAgent String?

  @@index([date, path])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

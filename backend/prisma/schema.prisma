generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  username          String?   @unique
  displayUsername   String?
  email             String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PatchVersion {
  id                String   @id @default(cuid())
  version           String
  date              String
  size              String
  supernovaLink     String?
  bigbangLink       String?
  supernovaRomLink  String?
  bigbangRomLink    String?
  supernovaRomSize  String?
  bigbangRomSize    String?
  changelog         String[]
  isLatest          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TeamMember {
  id        String @id @default(cuid())
  name      String
  role      String
  category  String
  discordId String?
  avatarUrl String?
  sortOrder Int    @default(0)
}

model TimelineEvent {
  id          String @id @default(cuid())
  date        String
  title       String
  description String
  sortOrder   Int    @default(0)
}

model Credit {
  id         String  @id @default(cuid())
  category   String
  personName String
  task       String?
  socialLink String?
  sortOrder  Int     @default(0)
}

model Screenshot {
  id        String @id @default(cuid())
  imageUrl  String
  sortOrder Int    @default(0)
}

model HeroBackground {
  id        String @id @default(cuid())
  imageUrl  String
  sortOrder Int    @default(0)
}

model WikiTool {
  id          String     @id @default(cuid())
  name        String
  description String
  imagePath   String?
  link        String?
  tags        String[]
  sortOrder   Int        @default(0)
  pages       WikiPage[]
}

model WikiPage {
  id        String   @id @default(cuid())
  slug      String
  title     String
  content   String
  toolId    String?
  tool      WikiTool? @relation(fields: [toolId], references: [id], onDelete: Cascade)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id              String   @id @default("default")
  patchVersion    String
  patchDate       String
  patchSize       String
  supernovaLink   String?
  bigbangLink     String?
  supernovaRomLink String?
  bigbangRomLink   String?
  supernovaRomSize String?
  bigbangRomSize   String?
  showPatch       Boolean  @default(true)
  showRom         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  date      DateTime @default(now())
  userAgent String?
  referrer  String?

  @@index([date, path])
}

model DownloadEvent {
  id      String   @id @default(cuid())
  file    String
  date    DateTime @default(now())
  userAgent String?

  @@index([date, file])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  category  String   @default("non-classé")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  imageUrl    String?
  status      String   @default("0%")
  releaseDate String?
  downloadUrl String?
  filePath    String?
  fileSize    String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
